FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type    fixedValue;
        value   uniform 0.09375;   // 0.09375 m^2/s^2 uniform inlet
    }
    outlet
    {
        type    inletOutlet;
        inletValue  uniform 0;
        value       uniform 0;
    }
    topWall
    {
        type    kqRWallFunction;
        value   uniform 0;
    }
    bottomWall
    {
        type    kqRWallFunction;
        value   uniform 0;
    }
    frontBack
    {
        type    empty;
    }
}